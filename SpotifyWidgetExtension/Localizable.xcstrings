    "Nothing playing on Spotify": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-da heç nə səslənmir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Spotify wird nichts abgespielt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se está reproduciendo nada en Spotify"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune lecture en cours sur Spotify"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna riproduzione su Spotify"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyで再生中の曲はありません"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-да ештеңе ойнатылмай тұр"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify에서 재생 중인 항목 없음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-да эч нерсе ойнотулбай жатат"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada tocando no Spotify"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Spotify ничего не играет"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-da hiç zat çalynmaýar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify'da çalan bir şey yok"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyʼda hech narsa ijro etilmayapti"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 未在播放"
          }
        }
      }
    },
    "Now playing and playback controls.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səslənən mahnı və oxutma idarəetməsi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktueller Titel und Wiedergabesteuerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que suena y controles de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture en cours et commandes de lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brano in riproduzione e controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の曲と再生コントロール。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір ойнап тұрған ән және ойнатуды басқару."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 재생 중인 곡과 재생 컨트롤."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыр ойноп жаткан ыр жана ойнотууну башкаруу."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocando agora e controles de reprodução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий трек и управление воспроизведением."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Häzir çalynýan aýdym we dolandyryş düwmeleri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalan şarkı ve oynatma kontrolleri."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir ijro etilayotgan qoʻshiq va ijro boshqaruvi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放和播放控制。"
          }
        }
      }
    },
